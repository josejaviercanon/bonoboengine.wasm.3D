{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "serve-production-wasm",
      "type": "shell",
      "command": "dotnet-serve",
      "args": [
        "-d", "src/Game.Wasm/bin/Release/net10.0/publish/wwwroot",
        "-p", "63008",
        "--fallback-file", "index.html"
      ],
      "isBackground": true,
      "problemMatcher": {
        "pattern": [
          {
            "regexp": "^.*$",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          // Matches when dotnet-serve prints out its URL to the console
          "beginsPattern": ".*",
          "endsPattern": ".*(http://localhost:63008).*"
        }
      }
    },
    {
      "label": "publish-winapp-aot",
      "detail": "Compile Game.WinApp (WinUI 3 + WebView2) to a native win-x64 AOT binary, rebuilding the frontend first.",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "publish",
        "src/Game.WinApp/Game.WinApp.csproj",
        "-c", "Release",
        "-r", "win-x64",
        "-p:Platform=x64",
        "-p:BuildFrontend=true"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish-wasm-aot",
      "detail": "Publish the browser-wasm host (Native AOT) with a fresh frontend build.",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "publish",
        "src/Game.Wasm/Game.Wasm.csproj",
        "-c", "Release",
        "-p:BuildFrontend=true"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
