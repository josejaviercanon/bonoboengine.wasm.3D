{
  "name": "bonoboengine.wasm.3d",
  "version": "1.0.0",
  "description": "Bonobo Engine browser-wasm host frontend: Babylon.js 3D rendering over the zero-copy C# shared-memory bridge, built with Vite and Tailwind CLI.",
  "type": "module",
  "scripts": {
    "build:js": "vite build && node -e \"import{cpSync}from'fs';cpSync('node_modules/@babylonjs/havok/lib/esm/HavokPhysics.wasm','wwwroot/dist/HavokPhysics.wasm')\"",
    "build:js:web": "vite build --mode web",
    "build:css": "npx @tailwindcss/cli -i ./Frontend/app.css -o ./wwwroot/dist/app.css --minify",
    "build": "npm run build:js && npm run build:css",
    "dev": "node scripts/dev.mjs",
    "build:web": "npm run build:js:web && npm run build:css",
    "typecheck": "tsc -b",
    "watch:js": "vite build --watch",
    "watch:js:web": "vite build --watch --mode web",
    "watch:css": "npx @tailwindcss/cli -i ./Frontend/app.css -o ./wwwroot/dist/app.css --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josejaviercanon/bonoboengine.wasm.3D.git"
  },
  "dependencies": {
    "@babylonjs/core": "^9.0.0",
    "@babylonjs/gui": "^9.26.0",
    "@babylonjs/havok": "^1.3.14"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^24.0.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "spectorjs": "^0.9.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
