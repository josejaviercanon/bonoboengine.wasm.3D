<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RunAOTCompilation Condition="'$(Configuration)' == 'Release'">true</RunAOTCompilation>
    <WasmStripILAfterAOT Condition="'$(Configuration)' == 'Release'">true</WasmStripILAfterAOT>
    <InvariantGlobalization>true</InvariantGlobalization>
    <InvariantTimezone>true</InvariantTimezone>
    <TrimMode>full</TrimMode>
    <WasmGenerateAppBundle>true</WasmGenerateAppBundle>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Game.Engine\Game.Engine.csproj" />
    <ProjectReference Include="..\Game.UI\Game.UI.csproj" />
  </ItemGroup>

  <!--
    Vite + Tailwind output and static assets are copied into wwwroot before Build.
    Shared with Game.WinApp; see src/Game.UI/Game.UIAssets.targets.
    Missing bundle fails fast unless -p:BuildFrontend=true is passed.
  -->
  <Import Project="..\Game.UI\Game.UIAssets.targets" />

</Project>