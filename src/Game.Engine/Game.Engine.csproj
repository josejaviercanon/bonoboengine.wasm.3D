<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Single-player build switches (ADR-007). DEFAULT = SINGLE_PLAYER_LOCAL:
         sim runs co-located with the client, zero HTTP. Multiplayer/server
         authority is opt-in: pass /p:IsMultiplayer=true or /p:IsEcsServerSide=true
         to suppress the constant and keep the SSE/POST server path. -->
    <IsMultiplayer Condition="'$(IsMultiplayer)' == ''">false</IsMultiplayer>
    <IsEcsServerSide Condition="'$(IsEcsServerSide)' == ''">false</IsEcsServerSide>
    <DefineConstants Condition="'$(IsMultiplayer)' != 'true' and '$(IsEcsServerSide)' != 'true'">$(DefineConstants);SINGLE_PLAYER_LOCAL</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Arch\Arch.csproj" />
    <ProjectReference Include="..\Arch.Generators\Arch.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Game.Engine.Generators\Game.Engine.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- Authoritative 3D physics (ADR-011): BepuPhysics2, vendored. Deterministic
         single-threaded simulation on the browser-wasm host (null ThreadDispatcher). -->
    <ProjectReference Include="..\bepuphysics2\BepuPhysics\BepuPhysics.csproj" />
    <ProjectReference Include="..\bepuphysics2\BepuUtilities\BepuUtilities.csproj" />
  </ItemGroup>

</Project>
